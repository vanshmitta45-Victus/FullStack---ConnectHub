<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SDET Unified Suite" parallel="methods" thread-count="4">
    <listeners>
        <listener class-name="com.sdet.framework.listeners.TestListener"/>
    </listeners>
    <test name="UI Tests">
        <classes>
            <class name="com.sdet.framework.tests.LoginTest"/>
        </classes>
    </test>
    <test name="API Tests">
        <classes>
            <class name="com.sdet.framework.tests.UserApiTest"/>
        </classes>
    </test>
    <test name="E2E UI+API+DB Tests">
        <classes>
            <class name="com.sdet.framework.tests.TaskE2ETest"/>
        </classes>
    </test>
    <test name="BDD (Cucumber)">
        <classes>
            <class name="com.sdet.framework.runners.CucumberRunner"/>
        </classes>
    </test>
</suite>
